# Приклад файлу конфігурації для локального запуску
# Перейменуйте цей файл на .env та заповніть своїми реальними ключами

# Токен вашого Telegram-бота від @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Юзернейм вашого публічного каналу (наприклад: @deutsch_dlya_ukraintsiv)
# або числовий ID приватного каналу (наприклад: -1001234567890)
TELEGRAM_CHAT_ID=@your_channel_username

# Безкоштовний ключ Google Gemini API (отриманий на aistudio.google.com)
GEMINI_API_KEY=AIzaSyD-your-gemini-api-key-here
